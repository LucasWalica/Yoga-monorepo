# --- Django ---
DJANGO_SECRET_KEY=reemplazar-con-clave-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=tu-dominio-o-ip
CORS_ALLOWED_ORIGINS=https://tu-dominio-o-ip,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://tu-dominio-o-ip

# --- Base de datos ---
POSTGRES_DB=sebasyoga
POSTGRES_USER=sebasyoga
POSTGRES_PASSWORD=cambiar-contrasena-postgres

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_COOKIE_SECURE=1

# --- WebAuthn (passkeys) ---
WEBAUTHN_RP_ID=tu-dominio-o-ip
WEBAUTHN_RP_NAME=Seba Yoga

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=

# --- Email / frontend ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Seba Yoga <hola@sebayoga.com>
FRONTEND_URL=https://tu-dominio-o-ip